{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeBridge",
  "version": "1.1.0",
  "identifier": "com.typebridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TypeBridge 控制中心",
        "width": 480,
        "height": 620,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 500,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}