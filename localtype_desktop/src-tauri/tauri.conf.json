{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalType",
  "version": "1.2.5",
  "identifier": "com.localtype.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalType 控制中心",
        "width": 900,
        "height": 680,
        "resizable": true,
        "minWidth": 600,
        "minHeight": 400,
        "transparent": false,
        "titleBarStyle": "Visible",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/VenenoSix24/localtype/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzQkQ0MUQ2QTUxRDM4MEUKUldRT09CMmwxa0c5czNETDBwYU9NTVBzNnZvT1o0ZTh3bElyeGJOK2xMRG0raHpHUm9kOEVPcFIK"
    }
  }
}